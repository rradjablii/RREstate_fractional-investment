# Copy to .env and fill in. Never commit .env.
POSTGRES_DB=rrestate
POSTGRES_USER=rrestate
POSTGRES_PASSWORD=CHANGE_ME

# dev: ephemeral JWT keys, relaxed cookies, investing on.  prod: keys REQUIRED.
SPRING_PROFILES_ACTIVE=dev
JWT_ISSUER=rrestate
# Base64 DER (no PEM headers). Generate: see README "JWT keys".
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# First admin account (created at startup if absent; password >= 12 chars)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Compliance gates — keep false until legal structure is approved
INVESTMENT_ENABLED=false
KYC_REQUIRED=true

# Reverse proxy
SITE_ADDRESS=:80
HTTP_PORT=8081
RRESTATE_VERSION=0.1.0

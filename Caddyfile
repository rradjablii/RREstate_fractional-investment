# SITE_ADDRESS=:80 for local (HTTP). Set to your domain (e.g. rrestate.com) in production for automatic HTTPS.
{$SITE_ADDRESS::80} {
	encode zstd gzip

	header {
		Content-Security-Policy "default-src 'self'; img-src 'self' https: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	handle /api/* {
		reverse_proxy backend:8080
	}
	handle {
		reverse_proxy frontend:8080
	}
}
